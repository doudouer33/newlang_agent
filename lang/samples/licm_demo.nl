// 样例 5：循环不变量外提（LICM）的试金石
// 循环体里 k * n 每轮都算，但 k、n 循环中都不变 —— 是纯粹的循环不变量。
// baseline 每轮都乘一次；licm 把它提到循环外只乘一次。
// s = n 次累加 (k*n) = n * k * n = 100 * 3 * 100 = 30000
// expect: 30000
//
// 选这个形状是因为收益能被 instr_count 干净地量出来：循环转 100 轮，
// 外提一条 mul 就少执行约 100 条指令，且结果必须仍是 30000（先过正确性）。

let n = 100;
let k = 3;
let s = 0;
let i = 0;

while (i < n) {
  s = s + k * n;
  i = i + 1;
}

print s;                // 30000
